{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "本 repo 自己的 action 以 @v1 引用，不釘 digest 也不自動更新：digest pin 對同 repo 的 action 沒有保護作用，只會讓 action 改動需要發兩次版才生效",
      "matchDepNames": ["TeamKugimiya/reusable-workflows{/,}**"],
      "pinDigests": false,
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "更新 Go toolkit CI 以 go install 精確固定的 lint/test 工具",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/Toolkit-(?:CI|Security)\\.yml$/"],
      "matchStrings": ["go install (?<depName>[^@\\s]+)@(?<currentValue>v[0-9][^\\s]*)"],
      "datasourceTemplate": "go"
    },
    {
      "description": "更新 zizmor-action 的 version 輸入；該版本號決定實際執行的 zizmor container",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/_zizmor\\.yml$/"],
      "matchStrings": ["version: (?<currentValue>v[0-9][^\\s]*)"],
      "depNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
